# ---------- LLM provider ----------
# ollama  -> local model, fully offline (needs 8GB+ RAM)
# groq    -> free cloud tier, very fast (needs GROQ_API_KEY)
# offline -> built-in rule-based playbooks (no LLM, demo never breaks)
LLM_PROVIDER=groq

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- Storage ----------
DUCKDB_PATH=data/aiops.duckdb

# Mirror logs into Elasticsearch so you can explore them in Kibana
ENABLE_ELASTICSEARCH=false
ES_URL=http://localhost:9200
ES_INDEX=server-logs

# ---------- ROI assumptions (used in the dashboard) ----------
DOWNTIME_COST_PER_MIN=5000
MANUAL_MTTR_MIN=45
AUTO_MTTR_MIN=5
